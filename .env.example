# Local development environment template (NO SECRETS).
# Copy to `.env` and fill real values locally.
# Never commit `.env` with real credentials.

NODE_ENV=development
PORT=8080

# --- Admin UX preview mode ---
# true  = premium gating is bypassed locally (for UX iteration)
# false = premium gating behaves like production (requires entitlement)
ADMIN_LOCAL_PREVIEW=false

# --- Stripe (TEST MODE) ---
# Required for /api/billing/checkout-session (server-side).
STRIPE_SECRET_KEY=sk_test_...

# Required for Embedded Checkout modal (client-side).
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Price IDs from Stripe Dashboard (Product catalog → Prices).
STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...

# Used to build success/cancel redirect URLs for Stripe Checkout.
SITE_URL=http://localhost:8080

# Required for /api/billing/webhook signature verification.
# Obtain via Stripe CLI `npm run stripe:listen` → copy the printed `whsec_...`.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Firestore (local) ---
# Optional: only needed if you want entitlements persisted locally.
# FIRESTORE_PROJECT_ID=your-gcp-project-id
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

